# log (default) writes to the console; smtp enables real email delivery.
EMAIL_DELIVERY_MODE=log

# Replace placeholders with your SMTP provider's settings before enabling smtp.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# false for STARTTLS (usually port 587); true for implicit TLS (usually port 465).
SMTP_SECURE=false
# Require STARTTLS when not using implicit TLS; certificate validation stays enabled.
SMTP_REQUIRE_TLS=true
# Set both credentials, or leave both empty for an unauthenticated relay.
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM="Galactic Spacefarer <no-reply@example.com>"
